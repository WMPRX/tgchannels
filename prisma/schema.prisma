generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  whatsapp_group
  whatsapp_channel
  telegram_group
  telegram_channel
  discord_server
}

enum GroupStatus {
  pending
  approved
  rejected
  removed
}

enum ReportReason {
  invalid_link
  illegal_content
  misleading
  other
}

enum ReportStatus {
  pending
  reviewed
  dismissed
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum UserRole {
  user
  admin
}

enum AuthProvider {
  google
  email
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  username       String
  passwordHash   String?       @map("password_hash")
  provider       AuthProvider  @default(email)
  avatarUrl      String?       @map("avatar_url")
  role           UserRole      @default(user)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  groups          Group[]
  highlightOrders HighlightOrder[]

  @@map("users")
}

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  translations CategoryTranslation[]
  groups       Group[]

  @@map("categories")
}

model CategoryTranslation {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  locale     String   @db.VarChar(5)
  name       String   @db.VarChar(100)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Group {
  id                 Int         @id @default(autoincrement())
  userId             String      @map("user_id")
  title              String      @db.VarChar(255)
  description        String      @db.Text
  platform           Platform
  categoryId         Int         @map("category_id")
  inviteLink         String      @db.VarChar(500) @map("invite_link")
  language           String      @default("tr") @db.VarChar(5)
  countryCode        String?     @db.VarChar(5) @map("country_code")
  viewCount          Int         @default(0) @map("view_count")
  isHighlighted      Boolean     @default(false) @map("is_highlighted")
  highlightExpiresAt DateTime?   @map("highlight_expires_at")
  status             GroupStatus @default(pending)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id])
  reports         Report[]
  highlightOrders HighlightOrder[]

  @@index([platform])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([viewCount])
  @@index([isHighlighted])
  @@map("groups")
}

model Report {
  id         Int          @id @default(autoincrement())
  groupId    Int          @map("group_id")
  reporterIp String       @db.VarChar(45) @map("reporter_ip")
  reason     ReportReason
  note       String?      @db.Text
  status     ReportStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model HighlightOrder {
  id            Int           @id @default(autoincrement())
  groupId       Int           @map("group_id")
  userId        String        @map("user_id")
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("TRY") @db.VarChar(3)
  paymentStatus PaymentStatus @default(pending) @map("payment_status")
  durationDays  Int           @map("duration_days")
  createdAt     DateTime      @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("highlight_orders")
}

model SponsorLink {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  url       String   @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sponsor_links")
}
